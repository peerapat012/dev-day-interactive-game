# AI runs only on the Next.js server. Set the real key later in .env.local.
# Full Azure Responses endpoint (https://<host>/openai/responses?api-version=...) or its /openai base.
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
# Azure OpenAI deployment name.
AI_MODEL=
# Explicit opt-in for development without a provider; never an automatic fallback.
LLM_USE_MOCK=false
# Keep your existing NEXT_PUBLIC_APPWRITE_* database/auth/realtime configuration.
