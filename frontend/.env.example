# AI runs only on the Next.js server. Set the real key later in .env.local.
GOOGLE_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
# Explicit opt-in for development without Gemini; never an automatic fallback.
LLM_USE_MOCK=false
# Keep your existing NEXT_PUBLIC_APPWRITE_* database/auth/realtime configuration.
